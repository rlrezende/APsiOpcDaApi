# Ignore build results
bin/
obj/
out/

# Ignore user-specific files
*.user
*.vs/
*.suo
*.userosscache
*.sln.docstates

# Ignore IDE files
.vscode/
.idea/
*.sln.iml

# Ignore Rider files
.idea/
*.sln.ide
*.sln.rej
*.sln.bak

# Ignore logs, debug, and crash reports
*.log
*.tlog
*.log.*

# Ignore files generated by Resharper
_ReSharper*/ 
*.DotSettings.user

# Ignore Visual Studio working files
.vs/

# Ignore package management folders
*.nuget/
packages/
NPM/
node_modules/
**/node_modules/

# Ignore files related to dotnet and NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg

# Ignore temporary files
~$*
*.tmp
*.temp
*.TMP
*.TEMP

# Ignore generated files
*.g.cs
*.g.i.cs
*.AssemblyAttributes.cs

# Ignore publish output
publish/
wwwroot/

# Ignore secrets and sensitive configuration files
appsettings*.json
secrets.json
env.json
.env
.DS_Store

.fake