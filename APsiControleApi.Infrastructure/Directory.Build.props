<Project>
  <PropertyGroup>
    <SoftingOpcSdkDir Condition="'$(SoftingOpcSdkDir)'==''">$(SOFTING_OPC_SDK_DIR)</SoftingOpcSdkDir>
    <SoftingOpcLibCandidate1>$(SoftingOpcSdkDir)\TBN461.dll</SoftingOpcLibCandidate1>
    <SoftingOpcLibCandidate2>$(SoftingOpcSdkDir)\bin\TBN461.dll</SoftingOpcLibCandidate2>
    <SoftingOpcLibrary Condition="Exists('$(SoftingOpcLibCandidate1)')">$(SoftingOpcLibCandidate1)</SoftingOpcLibrary>
    <SoftingOpcLibrary Condition="'$(SoftingOpcLibrary)'=='' and Exists('$(SoftingOpcLibCandidate2)')">$(SoftingOpcLibCandidate2)</SoftingOpcLibrary>
    <SoftingOpcBinDir Condition="'$(SoftingOpcLibrary)'!=''">$([System.IO.Path]::GetDirectoryName('$(SoftingOpcLibrary)'))</SoftingOpcBinDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)'=='Windows_NT' and '$(SoftingOpcLibrary)'!=''">
    <SoftingOpcEnabled>true</SoftingOpcEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SoftingOpcEnabled)'=='true' and '$(MSBuildProjectName)'=='APsiControleApi.Application'">
    <DefineConstants>$(DefineConstants);SOFTING_OPC</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SoftingOpcEnabled)'=='true' and '$(MSBuildProjectName)'=='APsiControleApi.API'">
    <DefineConstants>$(DefineConstants);SOFTING_OPC</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SoftingOpcEnabled)'=='true' and ('$(MSBuildProjectName)'=='APsiControleApi.Application' or '$(MSBuildProjectName)'=='APsiControleApi.API')">
    <Reference Include="Softing.OPCToolbox">
      <HintPath>$(SoftingOpcLibrary)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(SoftingOpcEnabled)'=='true' and '$(MSBuildProjectName)'=='APsiControleApi.API'">
    <None Include="$(SoftingOpcBinDir)\OTBu.dll" Condition="Exists('$(SoftingOpcBinDir)\OTBu.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SoftingOpcBinDir)\OTBux64.dll" Condition="Exists('$(SoftingOpcBinDir)\OTBux64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="SoftingDiagnostics" BeforeTargets="BeforeBuild">
    <Message Importance="High" Text="[Softing] SoftingOpcSdkDir=$(SoftingOpcSdkDir)" />
    <Message Importance="High" Text="[Softing] SoftingOpcEnabled=$(SoftingOpcEnabled)" />
    <Message Importance="High" Text="[Softing] SoftingOpcLibrary exists: @(Reference->'%(Filename)')" Condition="'$(SoftingOpcEnabled)'=='true'" />
  </Target>
</Project>
