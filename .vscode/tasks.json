{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill-port",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "fuser -k 5003/tcp 5001/tcp || true; pkill -f \"APsiOpcDaApi.API.dll|APsiOpcDaApi.API.csproj\" || true"],
      "problemMatcher": []
    },
    {
      "label": "build-api",
      "type": "shell",
      "dependsOn": "kill-port",
      "command": "/usr/bin/dotnet",
      "args": ["build", "${workspaceFolder}/APsiOpcDaApi.API/APsiOpcDaApi.API.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}
