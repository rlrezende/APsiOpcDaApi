{
    "version": "0.2.0",
    "configurations": [
        {
   e tes         "name": ".NET 9 API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "postDebugTask": "kill-port",
            "program": "/usr/bin/dotnet",
            "args": [
                "${workspaceFolder}/APsiOpcDaApi.API/bin/Debug/net9.0/win-x86/APsiOpcDaApi.API.dll"
            ],
            "cwd": "${workspaceFolder}/APsiOpcDaApi.API",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5003",
                "DOTNET_ROOT": "/usr/share/dotnet",
                "DOTNET_MULTILEVEL_LOOKUP": "1",
                "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=APsiCAthApiDb;Username=postgres;Password=Teste2010"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
